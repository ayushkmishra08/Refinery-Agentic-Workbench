# Virtual environment
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
*.egg

# IDE
.vscode/
.idea/
*.swp
*.swo

# Data artifacts (keep structure, ignore content)
data/raw/*.pdf
data/parsed/*.json
data/parsed/*.log
data/parsed/*.pid
# Bulky per-window raw Docling dumps and figure crops; the merged
# parsed_document.json / tables.json / metadata.json / parse_report.md
# in data/parsed/<doc>/ are the committed representation.
data/parsed/**/windows/
data/parsed/**/images/
data/parsed/**/parse_log.txt
data/normalized/*.json
data/knowledge/*.json
data/knowledge/**/chunk_embeddings.json
data/checkpoints/*.json
data/reports/**/*.md

# OS
Thumbs.db
.DS_Store

# Neo4j local data
neo4j-data/

# pipeline run logs
data/reports/*.log
data/parsed/**/*.log

# workbench runtime artefacts
data/workbench/sessions/*
data/workbench/audit/*
data/workbench/reports/*
!data/workbench/**/.gitkeep

data/workbench/cache/*
data/workbench/uploads/*
data/workbench/thinking/*
# credential store: password digests, salts and live session tokens. Never committed.
data/workbench/security/
!data/workbench/**/.gitkeep
