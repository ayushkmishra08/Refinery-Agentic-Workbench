{
  "$defs": {
    "Attachment": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "media_type": {
          "default": "application/pdf",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "name",
        "path"
      ],
      "title": "Attachment",
      "type": "object"
    }
  },
  "properties": {
    "text": {
      "title": "Text",
      "type": "string"
    },
    "session_id": {
      "default": "default",
      "title": "Session Id",
      "type": "string"
    },
    "user_role": {
      "default": "engineer",
      "title": "User Role",
      "type": "string"
    },
    "auth_token": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Bearer token from POST /auth/login; the role it names is what the access policy uses, not user_role",
      "title": "Auth Token"
    },
    "access_key": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "An approved one-time key (RGK.\u2026) opening the named records of one approved request, for this question only",
      "title": "Access Key"
    },
    "asked_text": {
      "default": "",
      "description": "What the engineer actually typed, when ``text`` is a follow-up the resolver rewrote to stand alone",
      "title": "Asked Text",
      "type": "string"
    },
    "attachments": {
      "items": {
        "$ref": "#/$defs/Attachment"
      },
      "title": "Attachments",
      "type": "array"
    },
    "options": {
      "additionalProperties": true,
      "description": "Frontend hints: {'want_report': true, 'max_steps': 12}",
      "title": "Options",
      "type": "object"
    }
  },
  "required": [
    "text"
  ],
  "title": "UserRequest",
  "type": "object"
}